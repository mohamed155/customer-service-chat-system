{
  "_about": "Module boundary rules (ADR-017, which amends ADR-001). Checked by tools/check-module-boundaries.mjs; the generated view is docs/architecture/module-dependencies.md.",
  "eventConsumers": [
    "analytics",
    "audit",
    "notifications"
  ],
  "flatModules": [
    "ai",
    "analytics",
    "audit",
    "authz",
