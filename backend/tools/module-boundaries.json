  "sharedTables": [
    "outbox_events",
    "secret_keks"
  ],
  "exceptions": [
    {
      "rule": "event-consumer-called",
      "from": "ai",
      "to": "notifications",
      "reason": "ai calls notifications::emit directly to raise tool-approval and failed-response notifications; ADR-001 would have notifications consume the AI turn events instead."
    }
  ],
  "readModels": {
    "analytics": {
      "tables": [
        "conversations",
        "messages",
        "escalations",
        "ai_generations",
        "ai_usage_records",
        "conversation_feedback"
      ],
      "reason": "Aggregates are computed over the operational tables at query time; they are read-only (analytics owns no table) until an event-built read model is worth its cost."
    }
  },
