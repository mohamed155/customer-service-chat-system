{
  "title": "Frontend Errors",
  "uid": "frontend-errors",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": [
    "frontend"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Errors reported, by kind (per 10 minutes)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (kind) (increase(frontend_errors_total[10m]))",
          "legendFormat": "{{ kind }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors reported, by backend release (per 10 minutes)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (release) (increase(frontend_errors_total[10m]))",
          "legendFormat": "{{ release }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Latest reports",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\".*backend.*\"} |= \"frontend error\" | json | target=\"frontend\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ]
}
