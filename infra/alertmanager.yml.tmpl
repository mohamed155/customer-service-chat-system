route:
  receiver: webhook
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  continue: false

receivers:
  - name: webhook
    webhook_configs:
      - url: '${APP_ALERT_WEBHOOK_URL}'
        send_resolved: true

inhibit_rules:
  - source_match:
      alertname: DependencyDown
    target_match:
      alertname: HighErrorRate
    equal: [severity]
