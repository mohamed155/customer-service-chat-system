{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "schematics": {
    "@schematics/angular:component": {
      "standalone": true
    },
    "@schematics/angular:directive": {
      "standalone": true
    },
    "@schematics/angular:pipe": {
      "standalone": true
    }
  },
  "projects": {
    "dashboard": {
      "projectType": "application",
      "root": "apps/dashboard",
      "sourceRoot": "apps/dashboard/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/dashboard/src/main.ts",
            "index": "apps/dashboard/src/index.html",
            "tsConfig": "apps/dashboard/tsconfig.app.json",
            "outputPath": "dist/dashboard",
            "styles": [
              "node_modules/@taiga-ui/styles/taiga-ui-theme.less",
              "node_modules/@taiga-ui/styles/taiga-ui-fonts.less",
              "apps/dashboard/src/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "node_modules/@taiga-ui/icons/src",
                "output": "assets/taiga-ui/icons"
              },
              {
                "glob": "theme-init.js",
                "input": "apps/dashboard/src",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "budgets": [
                { "type": "initial", "maximumWarning": "685kb", "maximumError": "700kb" },
                { "type": "allScript", "maximumWarning": "1950kb", "maximumError": "2000kb" },
                { "type": "anyScript", "maximumError": "450kb" },
                {
                  "type": "bundle",
                  "name": "conversation-detail-component",
                  "maximumWarning": "63kb",
                  "maximumError": "66kb"
                },
                {
                  "type": "bundle",
                  "name": "team-list-component",
                  "maximumWarning": "45kb",
                  "maximumError": "47kb"
                },
                {
                  "type": "bundle",
                  "name": "widgets-component",
                  "maximumWarning": "33kb",
                  "maximumError": "35kb"
                },
                {
                  "type": "bundle",
                  "name": "ai-agent-component",
                  "maximumWarning": "31kb",
                  "maximumError": "33kb"
                },
                {
                  "type": "bundle",
                  "name": "rich-text-editor-component",
                  "maximumWarning": "425kb",
                  "maximumError": "440kb"
                },
                { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "8kb" }
              ],
              "outputHashing": "all",
              "sourceMap": { "scripts": true, "styles": false, "hidden": true }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "apps/dashboard/src/environments/environment.ts",
                  "with": "apps/dashboard/src/environments/environment.development.ts"
                },
                {
                  "replace": "apps/dashboard/src/app/core/state/devtools.ts",
                  "with": "apps/dashboard/src/app/core/state/devtools.development.ts"
                }
              ]
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "apps/dashboard/src/environments/environment.ts",
                  "with": "apps/dashboard/src/environments/environment.e2e.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "dashboard:build:production" },
            "development": { "buildTarget": "dashboard:build:development" },
            "e2e": { "buildTarget": "dashboard:build:e2e" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/dashboard/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["apps/dashboard/src/test-setup.ts"],
            "coverageInclude": ["apps/dashboard/src/**/*.ts"],
            "coverageExclude": [
              "**/*.spec.ts",
              "**/*.testing.ts",
              "**/generated/**",
              "**/test-setup.ts"
            ],
            "coverageReporters": ["text-summary", "json-summary", "lcov", "html"]
          },
          "configurations": { "coverage": { "coverage": true } }
        }
      }
    },
    "widget": {
      "projectType": "application",
      "root": "apps/widget",
      "sourceRoot": "apps/widget/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/widget/src/main.ts",
            "index": "apps/widget/src/index.html",
            "tsConfig": "apps/widget/tsconfig.app.json",
            "outputPath": "dist/widget",
            "assets": [{ "glob": "**/*", "input": "apps/widget/public" }],
            "budgets": [{ "type": "initial", "maximumWarning": "195kb", "maximumError": "200kb" }]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "widget:build",
            "proxyConfig": "apps/widget/proxy.conf.cjs"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "widget:build",
            "tsConfig": "apps/widget/tsconfig.spec.json",
            "runner": "vitest",
            "coverageInclude": ["apps/widget/src/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "**/*.testing.ts", "**/generated/**"],
            "coverageReporters": ["text-summary", "json-summary", "lcov", "html"]
          },
          "configurations": { "coverage": { "coverage": true } }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
