{
  "name": "customer-service-platform-frontend",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "ng build",
    "build:widget-loader": "node apps/widget/tools/build-loader.mjs",
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o apps/dashboard/src/app/core/api/generated/api.ts && prettier --write apps/dashboard/src/app/core/api/generated/api.ts",
    "start": "ng serve dashboard",
    "lint": "eslint \"apps/**/*.{ts,html}\" \"libs/**/*.{ts,html}\"",
    "test": "ng test dashboard",
    "test:e2e": "playwright test",
    "test:widget-proxy": "node --test apps/widget/proxy.conf.test.mjs",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "quality": "pnpm ng build dashboard && pnpm ng test dashboard && pnpm test:e2e && pnpm lint && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node tools/install-git-hooks.mjs || echo lefthook install skipped",
    "lint:i18n": "node tools/check-i18n.mjs",
    "test:i18n-check": "node --test tools/check-i18n.test.mjs",
    "lint:tenant-scope": "node tools/check-tenant-scope.mjs",
    "lint:api-types": "node tools/check-generated-api-types.mjs",
    "test:tenant-scope-check": "node --test tools/check-tenant-scope.test.mjs",
    "test:api-types-check": "node --test tools/check-generated-api-types.test.mjs",
    "test:lint-rules": "node --test tools/eslint-rules/feature-boundaries.test.mjs",
    "test:coverage": "ng test dashboard --watch=false --configuration=coverage && ng test widget --watch=false --configuration=coverage && node tools/check-coverage.mjs",
    "test:coverage-check": "node --test tools/check-coverage.test.mjs",
    "test:symbolicate": "node --test tools/symbolicate.test.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@ngrx/effects": "22.0.1",
    "@ngrx/signals": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@taiga-ui/cdk": "^5.31.0",
    "@taiga-ui/core": "^5.31.0",
    "@taiga-ui/editor": "^5.7.1",
    "@taiga-ui/event-plugins": "^5.1.0",
    "@taiga-ui/icons": "^5.31.0",
    "@taiga-ui/kit": "^5.31.0",
    "@taiga-ui/styles": "^5.31.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@jridgewell/trace-mapping": "0.3.31",
    "@ngrx/store-devtools": "22.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "^22.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "openapi-typescript": "7.13.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11",
    "zone.js": "~0.16.3"
  }
}
