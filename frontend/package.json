{
  "name": "customer-service-platform-frontend",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "ng build",
    "build:widget-loader": "node apps/widget/tools/build-loader.mjs",
    "start": "ng serve dashboard",
    "lint": "eslint \"apps/**/*.{ts,html}\" \"libs/**/*.{ts,html}\"",
    "test": "ng test dashboard",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "quality": "pnpm ng build dashboard && pnpm ng test dashboard && pnpm test:e2e && pnpm lint && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"try{require('child_process').execSync('lefthook install',{stdio:'ignore'})}catch{console.warn('lefthook install skipped (no git repository); run: pnpm exec lefthook install')}\""
  },
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@ngrx/effects": "22.0.1",
    "@ngrx/signals": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@taiga-ui/cdk": "^5.23.0",
    "@taiga-ui/core": "^5.23.0",
    "@taiga-ui/editor": "^5.7.0",
    "@taiga-ui/event-plugins": "^5.0.0",
    "@taiga-ui/icons": "^5.23.0",
    "@taiga-ui/kit": "^5.23.0",
    "@taiga-ui/styles": "^5.23.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/language-service": "^22.1.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ngrx/store-devtools": "22.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "angular-eslint": "^22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.2.2",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
