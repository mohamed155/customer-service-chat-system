# Local development configuration. Copy to .env (`just up` does it for you) and edit.
#
#   - Real secrets never go in this file or in git: .env is ignored. Everything below is a
#     dev-only placeholder.
#   - Compose reads this file with `--env-file .env`. It expands the dollar sign even inside
#     comments, so never use one in a value or a comment.
#   - Full reference for the backend variables: docs/configuration.md.
#   - Variables marked "first start" are read only when the Docker volume is first created; to
#     change them later, recreate the volume (`just reset`, which DELETES local data).

# ------------------------------------------------------------------------------------------
# Backend: required
# ------------------------------------------------------------------------------------------

# PostgreSQL connection strings. Two roles, created on first start (see APP_OWNER_PASSWORD
# below), so that Row-Level Security applies to the running backend. Both must match POSTGRES_DB,
# POSTGRES_PORT and the role passwords below.
#   DATABASE_URL            app_runtime: what the server connects as (rows only, no DDL).
#   MIGRATION_DATABASE_URL  app_owner: `cargo run -p server -- migrate` and test setup only.
DATABASE_URL=postgres://app_runtime:app_runtime_dev@localhost:5432/customer_service
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner_dev@localhost:5432/customer_service

# Redis connection string (rate limiting, realtime fan-out). Must match REDIS_PORT below.
REDIS_URL=redis://localhost:6379

# HMAC secret that signs session JWTs. At least 32 bytes. Replace it in any shared environment.
AUTH_JWT_SECRET=0123456789abcdef0123456789abcdef

# Runtime environment: production, staging, development or test. Controls defaults such as log
# format, Swagger UI and which settings are mandatory.
APP_ENVIRONMENT=development
# Which parts of the server this process runs: api, gateway, worker or all (default). Keep `all`
# until realtime fan-out moves to Redis (ADR-009 RT1); see docs/configuration.md.
# APP_RUN_MODE=all
CORS_ALLOWED_ORIGINS=http://localhost:4200

# TCP port the backend HTTP server listens on.
PORT=8080

# ------------------------------------------------------------------------------------------
# Local services (infra/docker-compose.yml). All are first-start settings except the ports.
# ------------------------------------------------------------------------------------------

# Database name, and the bootstrap superuser created with it (administration only; the backend
# never connects as it). Keep POSTGRES_DB in step with the URLs above.
POSTGRES_DB=customer_service
POSTGRES_USER=customer_service
POSTGRES_PASSWORD=customer_service_dev

# MinIO (S3-compatible storage) root credentials, also used by the bucket bootstrap. If you
# change them, change APP_S3_ACCESS_KEY_ID / APP_S3_SECRET_ACCESS_KEY below to match.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Passwords for the two non-superuser database roles created on first start
# (infra/postgres/init/02-roles.sh):
#   app_owner   owns the schema and runs migrations.
#   app_runtime what the application connects as: read/write rows only, NOBYPASSRLS, owns nothing.
# DATABASE_URL and MIGRATION_DATABASE_URL above use them. If either is empty, neither role is
# created. To check that the split holds, run `just verify-roles` (see the README).
APP_OWNER_PASSWORD=app_owner_dev
APP_RUNTIME_PASSWORD=app_runtime_dev

# Host ports of the local services, all bound to 127.0.0.1. Uncomment one to move a service when
# its default port is taken or reserved (`just doctor` tells you). If you change one, update the
# matching URLs above (DATABASE_URL, MIGRATION_DATABASE_URL, REDIS_URL) and APP_S3_ENDPOINT.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# ------------------------------------------------------------------------------------------
# Backend: encryption keys (generate them, never reuse these placeholders anywhere shared)
# ------------------------------------------------------------------------------------------

# Base64-encoded 32-byte AES-256-GCM key that encrypts AI provider API keys at rest.
# Required outside the test environment. Generate with: openssl rand -base64 32
APP_AI_KEY_ENCRYPTION_KEY=

# Base64-encoded 32-byte AES-256-GCM key that encrypts integration connection secrets at rest.
# Optional; if set it must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
# APP_INTEGRATION_SECRETS_KEY=

# Root key of envelope encryption for tenant secrets (ADR-014). Optional: when unset the AI key
# above is used. A split deployment (a gateway process) must give every process the same value.
# APP_SECRETS_ROOT_KEY=
# The root key before a rotation, only while `server secrets rewrap-keks` has not finished.
# APP_SECRETS_ROOT_KEY_PREVIOUS=

# Optional per-provider base URL overrides (useful for testing or proxies):
# APP_AI_OPENAI_BASE_URL=
# APP_AI_ANTHROPIC_BASE_URL=
# APP_AI_GEMINI_BASE_URL=

# ------------------------------------------------------------------------------------------
# Backend: object storage (S3-compatible), used by the knowledge base
# ------------------------------------------------------------------------------------------

# Set all six or none; a partial configuration makes the server refuse to start. With none set,
# the server falls back to ephemeral in-memory storage. The application never creates buckets;
# the local MinIO already has `tenants` and `quarantine`, so APP_S3_BUCKET must be one of those
# (or a bucket you create yourself in the MinIO console).
# APP_S3_ENDPOINT=http://localhost:9000
# APP_S3_REGION=us-east-1
# APP_S3_BUCKET=
# APP_S3_ACCESS_KEY_ID=minioadmin
# APP_S3_SECRET_ACCESS_KEY=minioadmin
# Path-style addressing; defaults to true and is required for MinIO.
# APP_S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------------------
# Optional development switches
# ------------------------------------------------------------------------------------------

# max-age of the Strict-Transport-Security header. Set to 0 locally so the browser does not pin
# localhost to HTTPS (a non-zero value is painful to undo).
# APP_HSTS_MAX_AGE=0

# Set to 1 so database- and Redis-backed tests fail instead of silently skipping when the
# service is unreachable. Required for any test run whose result you intend to trust.
# REQUIRE_DB_TESTS=1
