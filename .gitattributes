# Normalise line endings to LF in the repository and in working trees.
# `text=auto` lets git detect binaries; files already committed with CRLF are left as they are
# until they are next edited and `git add --renormalize` is run on them.
* text=auto eol=lf

# Windows-only helper scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
*.gz binary
